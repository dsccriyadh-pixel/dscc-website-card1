# Required
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# The admin password for the /admin login — choose a strong, secret value.
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional
# SESSION_SECRET overrides the login-cookie signing key (defaults to ADMIN_PASSWORD).
# SESSION_SECRET=some-long-random-string
# PORT is usually provided by the host. Defaults to 3000 if unset.
# PORT=3000
NODE_ENV=production
